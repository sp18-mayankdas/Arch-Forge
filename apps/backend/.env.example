# AI provider (OpenAI-compatible). Defaults target NVIDIA's free hosted models.
# Get a free key at build.nvidia.com (sign in -> bind phone -> copy key).
AI_API_KEY=nvapi-your_key_here
AI_BASE_URL=https://integrate.api.nvidia.com/v1
# Copy the EXACT model id from the model's page on build.nvidia.com.
# Prefer an *instruct* model (not a reasoning one) for clean JSON output.
AI_MODEL=meta/llama-3.3-70b-instruct

PORT=3001

# To use a different provider instead, just change AI_BASE_URL / AI_MODEL / AI_API_KEY:
#   OpenAI:      AI_BASE_URL=https://api.openai.com/v1          AI_MODEL=gpt-4o-mini
#   Local Ollama:AI_BASE_URL=http://localhost:11434/v1         AI_MODEL=llama3.1   (AI_API_KEY=ollama)
