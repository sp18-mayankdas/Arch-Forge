# ─────────────────────────────────────────────────────────────────────────────
# AI provider. Set AI_PROVIDER to one value; only that provider's vars are used.
#   AI_PROVIDER=azure    -> Azure OpenAI (uses AZURE_OPENAI_*)
#   AI_PROVIDER=nvidia   -> NVIDIA NIM free tier (uses NVIDIA_AI_*)
#   AI_PROVIDER=groq     -> Groq free tier (uses GROQ_AI_*)
#   AI_PROVIDER=openai   -> any other OpenAI-compatible (uses AI_*)
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=azure

# --- Azure OpenAI (used when AI_PROVIDER=azure) ---
# From the Azure portal → your Azure OpenAI resource:
#   ENDPOINT  = "Keys and Endpoint" → Endpoint (e.g. https://my-resource.openai.azure.com)
#   API_KEY   = "Keys and Endpoint" → KEY 1
#   DEPLOYMENT= "Model deployments" (Azure AI Studio) → your deployment NAME (not the model id)
#   API_VERSION = a supported version string (2024-10-21 is a safe GA default)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-10-21

# --- NVIDIA NIM (used when AI_PROVIDER=nvidia) ---
# Free tier: sign up at https://build.nvidia.com, generate an API key (starts nvapi-...).
# Defaults to meta/llama-3.3-70b-instruct; uncomment NVIDIA_AI_MODEL to override.
NVIDIA_AI_API_KEY=nvapi-your_key_here
# NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1  (auto-default, uncomment to override)
# NVIDIA_AI_MODEL=meta/llama-3.3-70b-instruct              (auto-default, uncomment to override)

# --- Groq (used when AI_PROVIDER=groq) ---
# Free tier: sign up at https://console.groq.com, generate an API key (starts gsk-...).
# Defaults to llama-3.3-70b-versatile; uncomment GROQ_AI_MODEL to use alternative model.
GROQ_AI_API_KEY=gsk-your_key_here
# GROQ_AI_BASE_URL=https://api.groq.com/openai/v1        (auto-default, uncomment to override)
# GROQ_AI_MODEL=llama-3.3-70b-versatile                   (auto-default, uncomment to override)
# GROQ_AI_MODEL=mixtral-8x7b-32768                        (alternative: faster)
# GROQ_AI_MODEL=gemma2-9b-it                              (alternative: smaller, faster)

# --- Generic OpenAI-compatible (used when AI_PROVIDER=openai) ---
# For any other provider (e.g. OpenRouter, real OpenAI, Ollama). All three required, no defaults.
# Examples:
#   OpenRouter: AI_API_KEY=sk-or-...          AI_BASE_URL=https://openrouter.ai/api/v1      AI_MODEL=meta-llama/llama-3.1-70b-instruct:free
#   OpenAI:     AI_API_KEY=sk-...             AI_BASE_URL=https://api.openai.com/v1          AI_MODEL=gpt-4o-mini
#   Ollama:     AI_API_KEY=ollama              AI_BASE_URL=http://localhost:11434/v1          AI_MODEL=llama3.1
# AI_API_KEY=
# AI_BASE_URL=
# AI_MODEL=

PORT=3001
