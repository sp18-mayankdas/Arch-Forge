# ─────────────────────────────────────────────────────────────────────────────
# AI provider. Set AI_PROVIDER to pick which block below is used.
#   AI_PROVIDER=azure    -> Azure OpenAI
#   AI_PROVIDER=openai   -> any OpenAI-compatible endpoint (NVIDIA, OpenAI, Ollama…)
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=azure

# --- Azure OpenAI (used when AI_PROVIDER=azure) ---
# From the Azure portal → your Azure OpenAI resource:
#   ENDPOINT  = "Keys and Endpoint" → Endpoint (e.g. https://my-resource.openai.azure.com)
#   API_KEY   = "Keys and Endpoint" → KEY 1
#   DEPLOYMENT= "Model deployments" (Azure AI Studio) → your deployment NAME (not the model id)
#   API_VERSION = a supported version string (2024-10-21 is a safe GA default)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_DEPLOYMENT=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-10-21

# --- OpenAI-compatible (used when AI_PROVIDER=openai) ---
# NVIDIA free models: AI_BASE_URL=https://integrate.api.nvidia.com/v1  AI_API_KEY=nvapi-...
# OpenAI:             AI_BASE_URL=https://api.openai.com/v1            AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.3-70b-instruct

PORT=3001
