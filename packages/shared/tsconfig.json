{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Matches both apps. Without it tsc defaults to ES5 and loses Number.isFinite,
    // Array.prototype.includes and friends.
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["src"]
}
